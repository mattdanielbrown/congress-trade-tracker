# Server-side API keys — used only in Netlify Functions, never in client code.
# Copy this file to .env for local development with `netlify dev`.
# Never commit .env — it is listed in .gitignore.

CONGRESS_API_KEY="your_congress_api_key"
ALPHA_VANTAGE_KEY="your_alpha_vantage_api_key"
POLYGON_API_KEY="your_polygon_api_key"
AINVEST_API_KEY="your_ainvest_api_key"
POLITICIAN_TRADE_TRACKER_API_KEY="your_politician_trade_tracker_api_key"
